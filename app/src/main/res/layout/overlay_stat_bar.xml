<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#CC000000"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    android:layout_margin="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/overlay_fps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60 FPS"
            android:textColor="#00FFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <View android:layout_width="1dp" android:layout_height="12dp"
            android:background="#33FFFFFF" android:layout_marginHorizontal="8dp" />

        <TextView
            android:id="@+id/overlay_cpu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CPU: 42°C"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <View android:layout_width="1dp" android:layout_height="12dp"
            android:background="#33FFFFFF" android:layout_marginHorizontal="8dp" />

        <TextView
            android:id="@+id/overlay_gpu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPU: 35%"
            android:textColor="#FF00FF"
            android:textSize="10sp"
            android:fontFamily="monospace" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
